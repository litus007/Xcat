.bx-net-pill {
    position: fixed;
    top: calc(14px + env(safe-area-inset-top));
    left: 50%;
    transform: translateX(-50%);
    z-index: var(--bx-toast-z-index);
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px;
    border-radius: 999px;
    background: rgba(20, 20, 20, 0.88);
    border: 1px solid rgba(255, 255, 255, 0.5);
    color: #fff;
    font: 13px var(--bx-normal-font, sans-serif);
    box-shadow: 0 0 6px #000;
    pointer-events: none;

    .bx-net-pill-btn {
        pointer-events: auto;
        border: 0;
        border-radius: 999px;
        padding: 3px 10px;
        font: inherit;
        background: #c0392b;
        color: #fff;
        cursor: pointer;
    }
}

.bx-relay-pill {
    position: fixed;
    left: calc(12px + env(safe-area-inset-left));
    bottom: calc(12px + env(safe-area-inset-bottom));
    z-index: var(--bx-toast-z-index);
    padding: 6px 14px;
    border-radius: 999px;
    background: rgba(20, 20, 20, 0.88);
    border: 1px solid rgba(255, 255, 255, 0.5);
    color: #fff;
    font: 13px var(--bx-normal-font, sans-serif);
    pointer-events: none;
    max-width: calc(100vw - 40px);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.bx-relay-prompt {
    position: fixed;
    top: calc(16px + env(safe-area-inset-top));
    left: 50%;
    transform: translateX(-50%);
    z-index: calc(var(--bx-toast-z-index) + 1);
    min-width: 280px;
    max-width: calc(100vw - 32px);
    padding: 14px 16px;
    border-radius: 12px;
    background: #1a1b1e;
    border: 1px solid rgba(255, 255, 255, 0.6);
    color: #fff;
    font: 14px var(--bx-normal-font, sans-serif);
    text-align: center;
    box-shadow: 0 0 16px #000;

    .bx-relay-prompt-title { font-size: 16px; font-weight: bold; }
    .bx-relay-prompt-note { opacity: 0.7; margin: 4px 0 12px; font-size: 12px; }
    .bx-relay-prompt-buttons { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; }

    .bx-relay-btn {
        border: 0;
        border-radius: 999px;
        padding: 8px 16px;
        font: inherit;
        color: #fff;
        cursor: pointer;
        background: #3a3b40;

        &.bx-relay-allow { background: #107c10; }
        &.bx-relay-deny { background: #c0392b; }
        &:focus-visible { outline: 3px solid #fff; }
    }
}
